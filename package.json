{
  "name": "crm-soluciones-impresiona",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CRM de Soluciones Impresiona: clientes, cotizaciones, pedidos, producción y cobranza.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "db:instalador": "node scripts/generar-instalador.mjs",
    "build:demo": "VITE_DEMO=true vite build",
    "test:db": "vitest run tests/db src/data/modulos/real.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
