# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API).
#
# La "publishable key" (o "anon key") es pública por diseño: la seguridad la dan
# las reglas de acceso (RLS) de la base de datos. NUNCA pongas aquí la "secret key"
# ni la "service_role key".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Vista previa con datos ficticios (sin conexión a Supabase). Solo para demostraciones.
VITE_DEMO=false
